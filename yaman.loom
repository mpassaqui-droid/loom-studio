# ================================================================
#  LOOM — « YAMAN » : un raga du soir (Inde du Nord).
#
#  Pas juste une gamme : une TRADITION. (Tape ?raga dans la boîte VIBE.)
#   • Yaman = le mode LYDIEN (4e augmentée, le « tivra Ma »). Son RASA :
#     sérénité, dévotion, l'ouverture du soir.
#   • Un BOURDON (tanpura) tient Sa + Pa (degrés 1 et 5) du début à la fin —
#     c'est lui qui ancre l'oreille et rend tout « juste ».
#   • Les notes-pivots : G (3, vadi) et N (7, samvadi). La phrase-signature
#     monte N R G · M# D N (7, 1 3 · 4 6 7).
#   • Le MEEND (glissé) et les ornements se font avec slide et bend.
#   • tune: just -> les intervalles sont purs (consonance, zéro battement).
#
#  Forme : alap (libre, lent) -> jor (pulsation) -> gat (avec tabla).
#  > RUN. Laisse respirer. C'est lent par nature — l'espace fait partie du raga.
# ================================================================

title:  Yaman
bpm:    56
key:    d lydian          # Yaman : Sa=Ré, et la 4e (Ga#) est augmentée (tivra Ma)
tune:   just              # intonation pure, comme un vrai tanpura
feel:   22
warmth: 0.5
scene:           gaurora
scene@jor:       lissa3d
scene@gat:       mandala
film:   square
song:   alap*8 jor*8 gat*12 alap*4

# ---------- TANPURA : le bourdon Sa + Pa, présent de bout en bout ----------
# Sans @section ni | in : il sonne PARTOUT. C'est le coeur du raga.
tanpura: 1 . . . . . . . . . . . 5 . . . ; 5, . . . . . . . 1 . . . . . . . | pluck 0.4 | detune 3 | reverb 0.7 | delay 0.4 | gate 3 | gain 0.08 | hue 40
sa:      1 . . . . . . . . . . . . . . . | sine | oct 2 | sub 0.5 | env 2 1 0.9 3 | reverb 0.6 | gate 4 | gain 0.12 | hue 220

# ---------- ALAP : l'exposition libre et lente du raga (sitar, avec meend) ----------
# Phrases qui tournent autour des notes-pivots G (3) et N (7), montée prudente.
sitar@alap: 1 . . 7, . . 1 . . 3 . . 2 1 . . | pluck 0.7 | slide | lp 2200 | reverb 0.7 | delay 0.4 | echo 8 0.4 | bend -2 0.12 | humanize 40 | gain 0.13 | hue 180
phr@alap:   . . . . 3 . 4 . 6 . 7 . 1' . 7 6 | pluck 0.7 | slide | lp 2400 | reverb 0.7 | delay 0.4 | echo 8 0.45 | humanize 45 | gain 0.12 | hue 200
breath@alap: 1 . . . . . . . | sine | noise 0.5 | hp 800 | reverb 0.6 | gate 2 | gain 0.03

# ---------- JOR : une pulsation apparaît, les phrases s'animent ----------
sitar@jor: 7, . 1 3 . 2 1 . 3 4 6 . 7 6 . 5 | pluck 0.75 | slide | lp 2500 | reverb 0.6 | delay 0.3 | echo 6 0.4 | every 4 add 2 | humanize 35 | gain 0.13 | hue 180
jhala@jor: 1' . 1' . 7 . 1' . 6 . 1' . 7 . 5 . | pluck 0.6 | reverb 0.5 | gate 0.5 | pan 0.3 | gain 0.07 | hue 60
tampu@jor: 1 . 5 . 1 . 5 . 1 . 5 . 1 . 5 . | pluck 0.4 | gain 0.06 | pan -0.3 | hue 40

# ---------- GAT : le thème composé, avec tabla (teental, 16 temps) ----------
sitar@gat: 3 4 6 7 6 4 3 2 1 3 2 1' 7 6 5 3 | pluck 0.8 | slide | lp 2600 | reverb 0.55 | delay 0.25 | echo 8 0.4 | every 2 sometimes add 4 | humanize 30 | gain 0.13 | hue 180
answer@gat: . . . . 1' . 7 . . . 6 . 4 . 3 . | pluck 0.7 | slide | reverb 0.6 | delay 0.3 | gate 0.7 | jux rev | humanize 35 | gain 0.1 | hue 280
tabla@gat:  x . . x . . x . x . . x . x . . | sample perc | reson 300 0.4 | gain 0.22 | swing 54
tabla2@gat: . . x . x . . . . x . . x . . x | sample tabla | gain 0.16 | pan 0.2
naghma@gat: 1 . . . 5 . . . 1 . . . 4 . . . | bow | unison 2 | lp 1400 | reverb 0.6 | gate 1.6 | gain 0.05 | hue 300

# ----------------------------------------------------------------
#  Pour aller plus loin : key: c bhairav (raga du matin, grave) ·
#  tune: pyth · enlève le bourdon et écoute ce qui se perd.
# ----------------------------------------------------------------

# ================================================================
#  LOOM — « STUDIO » : une vitrine pour mixer/masteriser/arranger.
#
#  ▶ Pendant que ça joue, ouvre les outils DAW :
#    • 🎛 MIX  -> faders/pan/mute/solo + mètres par voix (et la tranche MASTER).
#    • la TIMELINE colorée sous l'éditeur : clique une section pour y sauter ;
#      sélectionne-la et +/−/dup/déplacer/supprimer pour ré-arranger.
#    • ▦ CLIPS -> lance d'autres morceaux quantisés, ou varie une voix (dev/rev/8va).
#    • EQ GRAVE/MÉDIUM/AIGU + ☰ MULTI -> masterise ; vise LUFS~ −14, évite le rouge.
#    • la voix « break » utilise | warp : l'amen se cale au tempo SANS changer de hauteur.
# ================================================================

title:  Studio
key:    c minor
tune:   just
bpm:    122
feel:   24
duck:   40
scene:  gaurora
song:   intro*4 groove*8 break*4 drop*8 groove*6 out*4

# ---------- RYTHME ----------
kick:   x . . . x . . . x . . . x . . . | sample bd | gain 0.5 | comp 0.4 | in groove drop out          # hue 20
snare:  . . . . x . . . . . . . x . . . | sample sd | gain 0.36 | in groove drop                        # hue 0
hat:    e(11,16) | sample hh | gain 0.13 | swing 56 | pan 0.2 | in groove drop out | hue 180
break@break:  x | sample amen | warp | crush 3 | gain 0.3 | hue 40                                       # WARP : l'amen étiré au tempo
break@drop:   x . . . . . . . x . . . . . x . | sample amen | warp | gain 0.26 | hue 40

# ---------- BASSE ----------
bass:   1 . . . 1' . . . 6, . . . 4, . . . | saw | oct 2 | slide | lp 600 q 7 | fenv 0.5 | drive 0.3 | develop | gain 0.16 | hue 0 | in groove drop out
sub:    1 . . . . . . . 5, . . . 4, . . . | sine | oct 1 | sub 0.6 | env 0.005 0.2 0.3 0.2 | gain 0.26 | in drop

# ---------- HARMONIE / NAPPES ----------
pad:    1 . . . 4 . . . 6 . . . 5 . . . | saw | unison 4 | detune 10 | vowel a | lp 1400 | reverb 0.7 | gate 2 | gain 0.07 | hue 280 | in intro groove break drop out
keys@drop: ^1 . . . ^4 . . . ^6 . . . ^5 . . . | sine | env 0.02 0.3 0.6 0.5 | reverb 0.4 | gain 0.1 | hue 220

# ---------- MÉLODIE (se développe) ----------
lead@groove: 1 . 3 . 5 . 1' . 7 . 5 . 3 . 2 . | pluck 0.7 | reverb 0.5 | delay 0.3 | echo 8 0.4 | develop | gate 0.6 | gain 0.12 | hue 300
lead@drop:   1 3 5 1' 7 5 3 2 1 5 1' 3' 1' 5 3 1 | sine | fm 1 2 | lp 2600 | delay 0.25 | gate 0.5 | develop | gain 0.1 | hue 320
shimmer@break: spectrum(8,c3) | bell | detune 4 | reverb 0.8 | echo 8 0.5 | gain 0.07 | hue 60          # accord spectral

# ---------- AIR ----------
air:    1 . . . . . . . | sine | noise 0.5 | hp 1000 | wow 0.2 | reverb 0.6 | gate 2 | gain 0.03 | in intro break out

# ----------------------------------------------------------------
#  Essaie : ☰ MULTI on/off · monte EQ AIGU · 🎛 MIX panne le hat · clique « drop » dans la timeline.
# ----------------------------------------------------------------
